<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>thruster_control</name>
  <version>0.1.0</version>
  <description>8채널 ROV 스러스터 제어 — 키보드 텔레옵으로 RPM 명령을 발행하고 SocketCAN으로 전달</description>
  <maintainer email="kwbnoa1234@gmail.com">hero</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <!-- thruster_can_node 가 python-can(SocketCAN) 사용 -->
  <exec_depend>python3-can</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
