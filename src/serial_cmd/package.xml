  <version>0.1.0</version>
  <description>CP2102 시리얼 포트로 텍스트 명령("1001", "x" 등) 전송</description>
  <maintainer email="kwbnoa1234@gmail.com">hero</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>serial_cmd_msgs</depend>
