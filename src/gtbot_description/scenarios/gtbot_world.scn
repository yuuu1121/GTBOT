			     실측 흘수(body z=+0.120)에서 판 하단(0.118)이 선체 림(0.115)과 z가 겹쳐
			     BEV 셀에서 판+선체가 한 컴포넌트로 묶이고 z-band가 plate 판정(0.10±0.04)을
			     초과해 기각됨(S4 재판정 중 실측). 10 cm 리프트로 림과 5 cm 분리.
			     센서(0.198 m) 기준 -0.030~+0.070 → ouster_cluster z 크롭 [-0.06, +0.10].
			     plate yaw는 mod-180이라 로봇 헤딩은 브리지에서 베어링 사전정보로 접어
			     해소(구 마스트 2기둥은 제거). -->
			<!-- 반사판 물리 파트 — gtbot·gtbot2와 동일(위 주석 참조). 세 로봇이 같은
			     메시를 쓰므로 장착 값도 동일하다. 종전 이 블록만 y=-0.10으로 값이 달라
			     일괄 치환에서 누락됐고, 그 결과 gtbot3만 판이 없어 검출 클러스터가
			     2개만 잡혔다(실측). -->
			<external_part name="Plate" type="box" physics="floating" buoyant="false">
				<dimensions xyz="0.138 0.008 0.098"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
				<mass value="0.15"/>
				<!-- yaw -1.5708(-90°) = 판 장축이 몸체 y축, 법선이 전방(x)을 향함.
				     GTBOT.obj(2026-08-11 사용자 수정본)의 판과 정확히 일치한다 — 원본
				     메시 실측: 장축 14.0 cm, 두께 1.00 cm, 장축 방위 -90.0°, 중심
				     (0.0014, -0.1386, -0.3347). 즉 시각 메시와 이 충돌 박스가 겹친다.
				     이 정렬이 중요한 이유: 지각은 판 장축이 헤딩에 수직이라고 보고
				     `헤딩 = 적합선 + 90°`로 계산하므로, 판이 틀어져 있으면 그 각도가
				     그대로 헤딩 편향이 된다(수정 전 22° 틀어짐 -> 68° 편향, 전 게이트
				     붕괴: S4 66.7~68.5°, S6 13.0 m). -->
				<compound_transform rpy="0.0 0.0 -1.5708" xyz="0.0014 -0.1386 -0.2847"/>
			</external_part>
		</base_link>
		<!-- 자세 디버깅용 임시 odometry (추후 팔로워 제어에도 유용) -->
		<sensor name="odometry" type="odometry" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/gtbot3/odometry"/>
		</sensor>
		<sensor name="imu" type="imu" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000021 0.000021 0.000023" angular_velocity="0.00050 0.00056 0.00054" linear_acceleration="0.0013 0.0013 0.0023"/>
			<ros_publisher topic="/gtbot3/imu_true"/>
		</sensor>

		<!-- 스러스터 4기: viz 메시의 프로펠러 지오메트리에서 추출한 실제 위치(림 90° 간격,
		     허브 z=0 = 흘수선 15 cm 아래)에 접선 방향으로 장착. body = NED(X·Y 수평, Z 아래).
		     추력은 스러스터 로컬 +X (Thruster.cpp thrustV(thrust,0,0)).
		     setpoint 순서 = 정의 순서 [E, W, N, S]. 믹서:
		       +X 병진: [0,0,-a,+a] / +Y 병진: [-a,+a,0,0] / yaw: [a,a,a,a]
		     주의: right="false" 프로펠러는 +setpoint 추력이 로컬 -X — inverted="true"로
		     상쇄해 부호를 맞춘 상태(W·S). 역추력은 정추력보다 약해(실물과 동일한 비대칭)
		     병진 시 약간의 yaw 커플링이 남음 — 제어기가 닫을 몫. -->
		<actuator name="ThrusterE" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.173 -0.162 0.0" rpy="0.0 0.0 -1.5708"/> <!-- +X_local -> body -Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterW" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.171 -0.162 0.0" rpy="0.0 0.0 1.5708"/> <!-- +X_local -> body +Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterN" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 -0.311 0.0" rpy="0.0 0.0 3.1416"/> <!-- +X_local -> body -X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterS" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 0.033 0.0" rpy="0.0 0.0 0.0"/> <!-- +X_local -> body +X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>

		<ros_subscriber thrusters="/gtbot3/sim_thrusters"/>  <!-- 실기 동일 경로: velocity_loop→bridge→thruster_rpm→rpm_to_sim→여기 -->
		<world_transform rpy="0.0 0.0 0.0" xyz="-0.75 -1.3 0.0"/>

		<!-- Active Marker (attached to bottom) -->
		<light name="aruco_led3">
			<specs illuminance="5000.0" radius="0.06" cone_angle="10" blink="0.125" shape="aruco" aruco_id="58"/>
			<color rgb="1.0 1.0 1.0"/>
			<link name="base_link"/>
		<origin xyz="0.0 -0.138 -0.65" rpy="0.0 0.0 0.0"/>
		</light>
		<light name="LED_OUTER_3">
			<specs radius="0.105" cone_angle="10.0" blink="0.125" illuminance="5000.0" shape="circle_square_hole" inner_radius="0.07"/>
			<color rgb="0.34 0.84 0.41"/>
			<link name="base_link"/>
			<origin xyz="0.0 -0.138 -1.165" rpy="0.0 0.0 0.0"/>
		</light>
	</robot>

	<!-- 고정 관측 카메라: 두 로봇(platform x=0, gtbot x=2, 중간점 x=1) 위에서 수직으로 내려다봄.
	     active_marker_id10.scn의 fixed robot + base_link type box 패턴을 사용. 회전 없는(rpy=0 0 0)
	     카메라 기본 광축은 로컬 +Z(NED에서 아래쪽) — blueboat_with_camera.scn의 camera_down 주석
	     "rpy=0 0 0 = looking DOWN (+Z in NED)"으로 확인된 컨벤션이라 azimuth 추측이 필요 없음. -->
	<robot name="ObserverCam" fixed="true" self_collisions="false">
		<base_link name="base_link" type="box" physics="surface" buoyant="false">
			<dimensions xyz="0.05 0.05 0.05"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<material name="Neutral"/>
			<look name="black"/>
		</base_link>

		<sensor name="view" rate="10.0" type="camera">
			<!-- 해상도 640x360(2026-08-16): 1280x720에서는 선언 rate 10 Hz 대비 실효 1.9 Hz밖에
			     안 나와 녹화가 뚝뚝 끊겼다(중복 프레임 37.2% 실측). 렌더링 부하를 1/4로 낮춘다.
			     화각·위치는 그대로라 프레이밍은 불변. 관측 전용이라 게이트·물리에는 영향 없다. -->
			<specs resolution_x="640" resolution_y="360" horizontal_fov="90.0"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<link name="base_link"/>
			<ros_publisher topic="/gtbot_world/view"/>
		</sensor>

		<!-- 배치(2026-08-15): 사각 경로 주행(leader_pilot 기본 웨이포인트 8×8 m, x·y 0~8)을
		     한 화면에 담도록 중심을 (4,4)로 옮기고 13 m 높이로 올린다. 수직 화각은
		     2·atan(tan(45°)·720/1280) = 58.7°이므로 13 m에서 세로 가시폭 14.6 m —
		     8 m 경로에 여유 3 m씩. 종전 (1,0,-6)은 세로 6.8 m라 경로가 잘렸다.
		     카메라 전용 변경이라 물리·센서·게이트에는 영향이 없다. -->
		<world_transform xyz="4.0 4.0 -13.0" rpy="0.0 0.0 0.0"/>
	</robot>

	<looks>
		<look name="pkrc" gray="0.8" roughness="0.4" metalness="0.3"/>
		<look name="blue" rgb="0.0 0.5 1.0" roughness="0.3"/>
		<look name="foam_green" rgb="0.0 1.0 0.0" roughness="0.5"/>
		<look name="ballast_red" rgb="1.0 0.0 0.0" roughness="0.5"/>
	</looks>

	<robot name="pkrc" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="submerged">
			<external_part name="Hull" type="model" physics="submerged" buoyant="true">
				<physical>
					<mesh filename="data/robots/PKRC/meshes/PKRC_robot.obj" scale="0.01"/>
					<origin rpy="-1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
					<thickness value="0.005"/>
				</physical>
				<visual>
					<mesh filename="data/robots/PKRC/meshes/PKRC_robot.obj" scale="0.01"/>
					<origin rpy="-1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="pkrc"/>
				<compound_transform rpy="0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>

			<internal_part name="FoamTop" type="box" physics="submerged" buoyant="true">
				<dimensions xyz="0.4 0.25 0.25"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="foam_green"/>
				<mass value="0.5"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.4"/>
			</internal_part>

			<internal_part name="BallastBottom" type="sphere" physics="submerged" buoyant="false">
				<dimensions radius="0.15"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Steel"/>
				<look name="ballast_red"/>
				<mass value="11.5"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.4"/>
			</internal_part>
		</base_link>

		<!-- Thrusters -->
        <actuator name="Surge_left" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 -0.15 -0.09" rpy="1.5707963268 3.14 0.0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Surge_right" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 0.15 -0.09" rpy="1.5707963268 3.14 0.0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

		<actuator name="Sway_left" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.15 0.0 -0.09" rpy="3.14 3.14 1.5707963268"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Sway_right" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.15 0.0 -0.09" rpy="3.14 3.14 1.5707963268"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Heave_left" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 0.16 0.12" rpy="0 1.5707963268 0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Heave_right" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 -0.16 0.12" rpy="0 1.5707963268 0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

		<!-- Sensors -->
		<sensor name="odometry" type="odometry" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/pkrc/odometry"/>
		</sensor>

		<sensor name="imu" type="imu" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000001745" angular_velocity="0.00001745"/>
			<ros_publisher topic="/pkrc/imu"/>
		</sensor>

		<sensor name="pressure" type="pressure" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise pressure="5.0"/>
			<ros_publisher topic="/pkrc/pressure"/>
		</sensor>

		<sensor name="dvl" type="dvl" rate="10.0">
			<link name="base_link"/>
			<origin rpy="1.571 0.0 1.571" xyz="0.0 0.0 0.0"/>
			<specs beam_angle="30.0"/>
			<range velocity="9.0 9.0 9.0" altitude_min="0.2" altitude_max="100.0"/>
			<noise velocity="0.0015" altitude="0.001"/>
			<ros_publisher topic="/pkrc/dvl" altitude_topic="/pkrc/altitude"/>
		</sensor>

		<sensor name="camera_front1" type="camera" rate="30.0">
			<link name="base_link"/>
			<origin rpy="1.571 0.0 -1.571" xyz="-0.1 -0.051 0.33"/>
			<specs resolution_x="1280" resolution_y="720" horizontal_fov="80.0"/>
			<ros_publisher topic="/pkrc/camera_front1"/>
		</sensor>

		<sensor name="camera_front2" type="camera" rate="30.0">
			<link name="base_link"/>
			<origin rpy="1.571 0.0 -1.571" xyz="-0.1 0.051 0.33"/>
			<specs resolution_x="1280" resolution_y="720" horizontal_fov="80.0"/>
			<ros_publisher topic="/pkrc/camera_front2"/>
		</sensor>

		<sensor name="camera_up" rate="60.0" type="camera">
			<specs resolution_x="1600" resolution_y="1200" horizontal_fov="82.0" />
			<origin xyz="0.0 0.0 -0.45" rpy="3.14 0.0 1.571"/>
			<link name="base_link"/>
			<ros_publisher topic="/pkrc/up"/>
		</sensor>

		<!-- Line Laser (always visible, with scanning) -->
		<linelaser name="front_laser">
			<specs range="20.0" line_width="0.002" num_rays="100" line_angle="45.0" scan_angle="20.0" scan_speed="20.0"/>
			<color rgb="0.0 1.0 0.0"/>
			<origin xyz="0.01 0.0 0.52" rpy="0.0 1.047 3.14"/>
			<!-- 90도 정면 -->
			<!-- <origin xyz="0.01 0.0 0.52" rpy="0.0 1.571 3.14"/> -->
			<link name="base_link"/>
		</linelaser>

		<world_transform xyz="0.0 0.0 4.0" rpy="0.0 0.0 0.0"/>
		<ros_base_link_transforms publish="true"/>
		<ros_subscriber thrusters="/pkrc/setpoint/pwm"/>
	</robot>
</scenario>
