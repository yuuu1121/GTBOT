<?xml version="1.0"?>
<scenario>
	<include file="data/common/environment.scn"/>
	<include file="data/common/materials.scn"/>
	<include file="data/common/visual.scn"/>

	<static name="SeaBed" type="plane">
		<material name="Seabed"/>
		<look name="seabed"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 10.0"/>
	</static>

	<!-- 메인: PKRC 부유 플랫폼 (수동 동체 — 액추에이터 없음) -->
	<robot name="platform" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="submerged">
			<external_part name="Hull" type="model" physics="submerged" buoyant="true">
				<physical>
					<mesh filename="data/objects/platform/meshes/platform_phy.obj" scale="0.01"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<visual>
					<mesh filename="data/objects/platform/meshes/platform_viz.obj" scale="0.01"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="orange"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
		</base_link>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</robot>

	<!-- 팔로워: GTBOT (액추에이터 없음 — 씬 로드 범위) -->
	<robot name="gtbot" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="submerged">
			<external_part name="Hull" type="model" physics="submerged" buoyant="true">
				<physical>
					<mesh filename="data/robots/gtbot/meshes/gtbot_phy.obj" scale="0.01"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<visual>
					<mesh filename="data/robots/gtbot/meshes/gtbot_viz.obj" scale="0.01"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="yellow"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
		</base_link>
		<world_transform rpy="0.0 0.0 0.0" xyz="2.0 0.0 0.0"/>
	</robot>

	<!-- 고정 관측 카메라: 두 로봇(platform x=0, gtbot x=2, 중간점 x=1) 위에서 수직으로 내려다봄.
	     active_marker_id10.scn의 fixed robot + base_link type box 패턴을 사용. 회전 없는(rpy=0 0 0)
	     카메라 기본 광축은 로컬 +Z(NED에서 아래쪽) — blueboat_with_camera.scn의 camera_down 주석
	     "rpy=0 0 0 = looking DOWN (+Z in NED)"으로 확인된 컨벤션이라 azimuth 추측이 필요 없음. -->
	<robot name="ObserverCam" fixed="true" self_collisions="false">
		<base_link name="base_link" type="box" physics="surface" buoyant="false">
			<dimensions xyz="0.05 0.05 0.05"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<material name="Neutral"/>
			<look name="black"/>
		</base_link>

		<sensor name="view" rate="10.0" type="camera">
			<specs resolution_x="1280" resolution_y="720" horizontal_fov="90.0"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<link name="base_link"/>
			<ros_publisher topic="/gtbot_world/view"/>
		</sensor>

		<world_transform xyz="1.0 0.0 -6.0" rpy="0.0 0.0 0.0"/>
	</robot>
</scenario>
