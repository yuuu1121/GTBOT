		<light name="aruco_led1">
			<specs illuminance="5000.0" radius="0.06" cone_angle="10" blink="0.125" shape="aruco" aruco_id="8"/>
			<color rgb="1.0 1.0 1.0"/>
			<link name="base_link"/>
		<origin xyz="0.0 -0.138 -0.65" rpy="0.0 0.0 0.0"/>
		</light>
		<light name="LED_OUTER_1">
			<specs radius="0.105" cone_angle="10.0" blink="0.125" illuminance="5000.0" shape="circle_square_hole" inner_radius="0.07"/>
			<color rgb="0.34 0.84 0.41"/>
			<link name="base_link"/>
			<origin xyz="0.0 -0.138 -1.165" rpy="0.0 0.0 0.0"/>
		</light>
	</robot>

