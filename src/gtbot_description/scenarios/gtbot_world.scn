		<actuator name="ThrusterW" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.171 -0.162 0.0" rpy="0.0 0.0 1.5708"/> <!-- +X_local -> body +Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterN" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 -0.311 0.0" rpy="0.0 0.0 3.1416"/> <!-- +X_local -> body -X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterS" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 0.033 0.0" rpy="0.0 0.0 0.0"/> <!-- +X_local -> body +X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>

		<ros_subscriber thrusters="/gtbot3/sim_thrusters"/>  <!-- 실기 동일 경로: velocity_loop→bridge→thruster_rpm→rpm_to_sim→여기 -->
		<world_transform rpy="0.0 0.0 0.0" xyz="-0.75 -1.3 0.0"/>
	</robot>

	<!-- 고정 관측 카메라: 두 로봇(platform x=0, gtbot x=2, 중간점 x=1) 위에서 수직으로 내려다봄.
	     active_marker_id10.scn의 fixed robot + base_link type box 패턴을 사용. 회전 없는(rpy=0 0 0)
	     카메라 기본 광축은 로컬 +Z(NED에서 아래쪽) — blueboat_with_camera.scn의 camera_down 주석
	     "rpy=0 0 0 = looking DOWN (+Z in NED)"으로 확인된 컨벤션이라 azimuth 추측이 필요 없음. -->
	<robot name="ObserverCam" fixed="true" self_collisions="false">
		<base_link name="base_link" type="box" physics="surface" buoyant="false">
			<dimensions xyz="0.05 0.05 0.05"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<material name="Neutral"/>
			<look name="black"/>
		</base_link>

		<sensor name="view" rate="10.0" type="camera">
			<!-- 해상도 640x360(2026-08-16): 1280x720에서는 선언 rate 10 Hz 대비 실효 1.9 Hz밖에
			     안 나와 녹화가 뚝뚝 끊겼다(중복 프레임 37.2% 실측). 렌더링 부하를 1/4로 낮춘다.
			     화각·위치는 그대로라 프레이밍은 불변. 관측 전용이라 게이트·물리에는 영향 없다. -->
			<specs resolution_x="640" resolution_y="360" horizontal_fov="90.0"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<link name="base_link"/>
			<ros_publisher topic="/gtbot_world/view"/>
		</sensor>

		<!-- 배치(2026-08-15): 사각 경로 주행(leader_pilot 기본 웨이포인트 8×8 m, x·y 0~8)을
		     한 화면에 담도록 중심을 (4,4)로 옮기고 13 m 높이로 올린다. 수직 화각은
		     2·atan(tan(45°)·720/1280) = 58.7°이므로 13 m에서 세로 가시폭 14.6 m —
		     8 m 경로에 여유 3 m씩. 종전 (1,0,-6)은 세로 6.8 m라 경로가 잘렸다.
		     카메라 전용 변경이라 물리·센서·게이트에는 영향이 없다. -->
		<world_transform xyz="4.0 4.0 -13.0" rpy="0.0 0.0 0.0"/>
	</robot>
</scenario>
