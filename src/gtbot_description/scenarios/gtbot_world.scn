<?xml version="1.0"?>
<scenario>
	<include file="data/common/environment.scn"/>
	<include file="data/common/materials.scn"/>
	<include file="data/common/visual.scn"/>

	<static name="SeaBed" type="plane">
		<material name="Seabed"/>
		<look name="seabed"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 10.0"/>
	</static>

	<!-- 메인: PKRC 부유 플랫폼 (수동 동체 — 액추에이터 없음)
	     실물 14 kg. phy 메시는 Y-up이라 NED(Z-down)로 rpy=-1.571 회전(pkrc.scn 컨벤션).
	     phy 메시 폐부피 12.66 L < 14 kg → 메시만으론 침몰하므로 실물 부유체를 대신하는
	     Foam internal part(24 L)로 배수량 보충. CG는 선저 근처(z=-0.05)로 내려 복원력 확보. -->
	<robot name="platform" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="floating">
			<external_part name="Hull" type="model" physics="floating" buoyant="true">
				<physical>
					<mesh filename="data/objects/platform/meshes/platform_phy.obj" scale="0.01"/>
					<origin rpy="-1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<visual>
					<mesh filename="data/objects/platform/meshes/platform_viz.obj" scale="0.01"/>
					<origin rpy="-1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="orange"/>
				<mass value="14.0"/>
				<cg rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.05"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
			<internal_part name="Foam" type="box" physics="floating" buoyant="true">
				<dimensions xyz="0.4 0.4 0.15"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="orange"/>
				<mass value="0.1"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.17"/>
			</internal_part>
		</base_link>

		<sensor name="odometry" type="odometry" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/platform/odometry"/>
		</sensor>

		<!-- 스러스터 4기: viz 메시 프로펠러 클러스터에서 추출한 위치(림 90° 간격, 허브
		     z=-0.107 = 선저 위 23 cm 부근, 흘수선 아래)에 접선 장착. body = NED.
		     메시 임포트 회전이 gtbot(+90°)과 달리 -90°라 접선 방향이 거울상 —
		     N/S를 body -Y/+Y 쪽에 배치해 gtbot과 동일한 믹서가 성립하도록 프레임을 잡음.
		     setpoint 순서 [E, W, N, S], gtbot과 동일 믹서:
		       +X 병진: [0,0,-a,+a] / +Y 병진: [-a,+a,0,0] / yaw: [a,a,a,a] -->
		<actuator name="ThrusterE" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.194 -0.019 -0.107" rpy="0.0 0.0 -1.5708"/> <!-- +X_local -> body -Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="orange"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterW" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.194 0.019 -0.107" rpy="0.0 0.0 1.5708"/> <!-- +X_local -> body +Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="orange"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterN" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.019 -0.194 -0.107" rpy="0.0 0.0 3.1416"/> <!-- +X_local -> body -X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="orange"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterS" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.019 0.194 -0.107" rpy="0.0 0.0 0.0"/> <!-- +X_local -> body +X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="orange"/>
			</propeller>
		</actuator>

		<!-- IMU 잡음(2026-08-12): 실기 정지 55분 로그 imu_run1의 /imu/ddpm 실측.
		     angle은 1 s 이동평균 대비 잔차(백색 성분) roll·pitch 0.0012°, yaw 0.0013°.
		     angular_velocity·linear_acceleration은 정지 표본의 축별 표준편차.
		     축별 벡터형인 이유: AHRS는 중력 기준인 roll·pitch와 자이로 적분인 yaw의
		     특성이 달라 스칼라 한 값으로 묶으면 안 된다.
		     linear_acceleration y는 실측이 16만 샘플 내내 정확히 0(죽은 채널인지
		     완벽 정렬인지 미판별)이라 x값을 잠정 적용 — 기울임 시험 후 갱신할 것.
		     **드리프트는 여기 없다**: Stonefish yaw_drift는 결정론적 램프뿐이라
		     실측의 배회를 못 낸다. 로봇 3대는 imu_drift_shim이 주입한다(imu_true 경유).
		     플랫폼도 로봇과 같은 기종으로 확정(2026-08-13, 사용자)이라 동일 실측값을
		     쓰고 드리프트도 로봇과 같이 imu_drift_shim으로 주입한다(imu_true 경유). -->
		<sensor name="imu" type="imu" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000021 0.000021 0.000023" angular_velocity="0.00050 0.00056 0.00054" linear_acceleration="0.0013 0.0013 0.0023"/>
			<ros_publisher topic="/platform/imu_true"/>
		</sensor>
		<!-- 커스텀 rotatinglidar — Ouster OS0-128 (REV7.1 데이터시트 + 실물 랩 구성
		     gtbot_lidar_cluster: OS0-128-SR, 10Hz). 최상단 장착, 틸트 없음(스펙 결정).
		     - 1024x128 @ 10Hz: 데이터시트 기준 모드. 2048x128도 시도했으나 레이 262k로
		       발행률이 1.8Hz로 붕괴(실측)해 원복 — 1024가 실시간 상한. 수평 0.35°(3.6m에서
		       2.2cm < ⌀3cm 마스트)라 단일 스캔으로 마스트가 잡힌다 — OS0는 반복 스캔이라
		       Mid-360식 누적 해상도 이득이 없고, 단일 스캔 밀도가 곧 유효 해상도다
		       (RotatingLidar.cpp에서 위상 지터 제거).
		     - vertical_fov 90.8: 대칭 ±45.4°(RotatingLidar가 대칭 분할).
		     - range_min 0.5: FW 기본값(0.3 옵션). range_max 35: 10% 반사율 기준.
		     - noise 0.004(2026-08-17 실물 정합): 종전 0.01은 판 클러스터를 3.4 cm 두께로
		       부풀려 실물 1.3 cm(정지 bag)의 2.6배였다(종횡비 시뮬 0.240 vs 실물 0.085).
		       두께가 잡음에 거의 선형이라 0.01x1.3/3.4 = 0.004로 맞춘다. 데이터시트
		       근거리 정밀도 ±0.8 cm 안쪽이라 스펙과도 정합. **주의**: 얇아지면 헤딩
		       적합이 유리해져 기존 게이트 수치가 낙관 쪽으로 이동한다 — 재판정 대상.
		     - 레이 수 131k/스캔 = 검증된 480x120(57.6k) 대비 2.3배. **여기가 발행률
		       병목이다**(2026-08-17 규명): 이 센서는 렌더가 아니라 CPU 레이캐스트다
		       (RotatingLidar.cpp가 레이마다 btCollisionWorld::rayTest, 단일 스레드).
		       그래서 메시 감량·rendering_quality가 안 들었고 RTF는 0.998인데 LiDAR만
		       1~5 Hz다. 262k에서 1.8 Hz, 131k에서 2~5 Hz로 레이 수에 반비례한다.
		       **512x128 감축은 기각** — 판 위 점 수가 이미 실물보다 부족하다(시뮬 176
		       @0.87 m를 1/r²로 1.05 m 환산 121점 vs 실물 134~157). 각분해능을 보존하며
		       레이만 줄이는 경로(수직 시야 축소)나 레이캐스트 병렬화로 가야 한다. -->
		<sensor name="lidar" type="rotatinglidar" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.36"/>
			<specs horizontal_steps="1024" vertical_steps="128" horizontal_fov="360.0"
			       vertical_fov="90.8" range_min="0.5" range_max="35.0"/>
			<noise range_stddev="0.004"/>
			<!-- 반환강도 실물 정합(2026-08-17). 종전은 판=255/그외=1 이진이라 실물
			     파이프라인(ouster_cluster)의 반사강도 필터를 켤 수 없었고, 시뮬 전용
			     지름길(platform_perception input_mode='points', intensity_min=100)로
			     우회하고 있었다 — 실물 강도 최대가 45라 그 지름길은 실기로 못 옮긴다.
			     모델은 I = gain*cos(입사각)/r^2 (실물 signal이 거리·입사각 의존).
			     plate_gain 22.1 = 실물 판 중앙 20 @1.05 m 역산(20*1.05^2).
			     **bg_gain 1.0은 측정값이 아니라 가정이다** — 실물 bag이 검출 후
			     산출물(box_points)이라 배경 강도 분포를 볼 수 없다. 판/배경 분리
			     여유는 미검증이고, 원 점군(/ouster/points) bag이 있어야 고정된다.
			     이 모델은 실물의 거리 한계도 재현한다: 2.1 m 밖에서 판 강도가
			     ouster_cluster의 bev_refl_min 5.0 아래로 떨어진다(실측 스위트스폿
			     ~1.5 m, 2.5~3 m 급락과 일치). -->
			<intensity plate_gain="22.1" bg_gain="1.0" max="255.0"/>
			<ros_publisher topic="/ouster/points"/>  <!-- ouster-ros 드라이버 규약과 동일 토픽: 실기·시뮬 검출기 설정 통일 -->
		</sensor>
		<ros_subscriber thrusters="/platform/thrusters"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</robot>

	<!-- 팔로워: GTBOT
	     실물 8 kg < phy 메시 폐부피 11.99 L → 질량만 맞추면 부유.
	     메시는 -Y가 위인 컨벤션이라 rpy=+1.5708(X축 +90°)로 base_link을 표준 NED에
	     정렬: body X·Y = 수평, Z = 아래. odometry roll/pitch ≈ 0, 이동은 X·Y축. -->
	<robot name="gtbot" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="floating">
			<external_part name="Hull" type="model" physics="floating" buoyant="true">
				<physical>
					<mesh filename="data/robots/gtbot/meshes/gtbot_phy.obj" scale="0.01"/>
					<origin rpy="1.5708 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<visual>
					<!-- 사용자 제작 모델(판 포함, 2026-08-10). 물리는 gtbot_phy 유지 = 거동 불변 -->
					<mesh filename="data/robots/gtbot/meshes/GTBOT.obj" scale="0.01"/>
					<origin rpy="1.5708 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="yellow"/>
				<mass value="8.0"/>
				<!-- CG는 잠긴 부분 CB(0.002, -0.139, -0.093)의 수직 아래(z 큰 쪽)에.
				     x·y가 CB와 어긋난 만큼 기울어진 채 평형 — 잔여 기울기 노브 = x·y(±0.01). -->
				<cg rpy="0.0 0.0 0.0" xyz="0.0 -0.139 0.235"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
			<!-- 실물 마커: 14x10cm 반사판(두께 2cm), gtbot_lidar_cluster(ouster_cluster)가
			     BEV 라인 검출로 위치·yaw를 추정하는 대상. 장착: 중앙 상부구조물 상면
			     (body y=-0.10, 갑판 z=-0.188), 장축 = body Y, 면 법선 = body X.
			     수면 위 스팬 0.168~0.268 m(갑판에서 10 cm 리프트). 5 cm 리프트로는 부족:
			     실측 흘수(body z=+0.120)에서 판 하단(0.118)이 선체 림(0.115)과 z가 겹쳐
			     BEV 셀에서 판+선체가 한 컴포넌트로 묶이고 z-band가 plate 판정(0.10±0.04)을
			     초과해 기각됨(S4 재판정 중 실측). 10 cm 리프트로 림과 5 cm 분리.
			     센서(0.198 m) 기준 -0.030~+0.070 → ouster_cluster z 크롭 [-0.06, +0.10].
			     plate yaw는 mod-180이라 로봇 헤딩은 브리지에서 베어링 사전정보로 접어
			     해소(구 마스트 2기둥은 제거). -->
			<!-- 반사판 물리 파트(2026-08-11). GTBOT.obj의 판은 **visual 전용**이라 라이다
			     레이캐스트(Bullet 충돌 월드 = physical 메시)가 볼 수 없었고, 그래서 강도
			     모델이 판 대신 돔 상면을 잡아 클러스터가 원형(종횡비 1.1~1.9)이 됐다.
			     GTBOT.obj를 physical로 쓰는 대안은 기각 — 경계 에지 78,221개의 열린 메시라
			     부력(폐부피) 계산이 불안정하고 면 수가 4배(80k)다.
			     시각 판과 동일한 위치·자세·크기의 박스를 충돌체로만 추가한다. 값은 원본
			     메시 실측: 중심 (0.0014, -0.1386, -0.2847), 장축 14 cm·두께 1 cm·높이 10 cm,
			     몸체 x축 기준 -22.4°(-0.391 rad) 회전. 장착 각도는 모델 그대로 유지(사용자
			     지시). 치수를 1~2 mm 작게 잡아 시각 메시와의 동일면 z-fighting을 피한다. -->
			<external_part name="Plate" type="box" physics="floating" buoyant="false">
				<dimensions xyz="0.138 0.008 0.098"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
				<mass value="0.15"/>
				<!-- yaw -1.5708(-90°) = 판 장축이 몸체 y축, 법선이 전방(x)을 향함.
				     GTBOT.obj(2026-08-11 사용자 수정본)의 판과 정확히 일치한다 — 원본
				     메시 실측: 장축 14.0 cm, 두께 1.00 cm, 장축 방위 -90.0°, 중심
				     (0.0014, -0.1386, -0.3347). 즉 시각 메시와 이 충돌 박스가 겹친다.
				     이 정렬이 중요한 이유: 지각은 판 장축이 헤딩에 수직이라고 보고
				     `헤딩 = 적합선 + 90°`로 계산하므로, 판이 틀어져 있으면 그 각도가
				     그대로 헤딩 편향이 된다(수정 전 22° 틀어짐 -> 68° 편향, 전 게이트
				     붕괴: S4 66.7~68.5°, S6 13.0 m). -->
				<compound_transform rpy="0.0 0.0 -1.5708" xyz="0.0014 -0.1386 -0.2847"/>
			</external_part>
		</base_link>
		<!-- 자세 디버깅용 임시 odometry (추후 팔로워 제어에도 유용) -->
		<sensor name="odometry" type="odometry" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/gtbot/odometry"/>
		</sensor>
		<sensor name="imu" type="imu" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000021 0.000021 0.000023" angular_velocity="0.00050 0.00056 0.00054" linear_acceleration="0.0013 0.0013 0.0023"/>
			<ros_publisher topic="/gtbot/imu_true"/>
		</sensor>

		<!-- 스러스터 4기: viz 메시의 프로펠러 지오메트리에서 추출한 실제 위치(림 90° 간격,
		     허브 z=0 = 흘수선 15 cm 아래)에 접선 방향으로 장착. body = NED(X·Y 수평, Z 아래).
		     추력은 스러스터 로컬 +X (Thruster.cpp thrustV(thrust,0,0)).
		     setpoint 순서 = 정의 순서 [E, W, N, S]. 믹서:
		       +X 병진: [0,0,-a,+a] / +Y 병진: [-a,+a,0,0] / yaw: [a,a,a,a]
		     주의: right="false" 프로펠러는 +setpoint 추력이 로컬 -X — inverted="true"로
		     상쇄해 부호를 맞춘 상태(W·S). 역추력은 정추력보다 약해(실물과 동일한 비대칭)
		     병진 시 약간의 yaw 커플링이 남음 — 제어기가 닫을 몫. -->
		<actuator name="ThrusterE" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.173 -0.162 0.0" rpy="0.0 0.0 -1.5708"/> <!-- +X_local -> body -Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterW" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.171 -0.162 0.0" rpy="0.0 0.0 1.5708"/> <!-- +X_local -> body +Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterN" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 -0.311 0.0" rpy="0.0 0.0 3.1416"/> <!-- +X_local -> body -X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterS" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 0.033 0.0" rpy="0.0 0.0 0.0"/> <!-- +X_local -> body +X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>

		<ros_subscriber thrusters="/gtbot/sim_thrusters"/>  <!-- 실기 동일 경로: velocity_loop→bridge→thruster_rpm→rpm_to_sim→여기 -->
		<world_transform rpy="0.0 0.0 0.0" xyz="1.5 0.0 0.0"/>
	</robot>

	<robot name="gtbot2" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="floating">
			<external_part name="Hull" type="model" physics="floating" buoyant="true">
				<physical>
					<mesh filename="data/robots/gtbot/meshes/gtbot_phy.obj" scale="0.01"/>
					<origin rpy="1.5708 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<visual>
					<!-- 사용자 제작 모델(판 포함, 2026-08-10). 물리는 gtbot_phy 유지 = 거동 불변 -->
					<mesh filename="data/robots/gtbot/meshes/GTBOT.obj" scale="0.01"/>
					<origin rpy="1.5708 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="yellow"/>
				<mass value="8.0"/>
				<!-- CG는 잠긴 부분 CB(0.002, -0.139, -0.093)의 수직 아래(z 큰 쪽)에.
				     x·y가 CB와 어긋난 만큼 기울어진 채 평형 — 잔여 기울기 노브 = x·y(±0.01). -->
				<cg rpy="0.0 0.0 0.0" xyz="0.0 -0.139 0.235"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
			<!-- 실물 마커: 14x10cm 반사판(두께 2cm), gtbot_lidar_cluster(ouster_cluster)가
			     BEV 라인 검출로 위치·yaw를 추정하는 대상. 장착: 중앙 상부구조물 상면
			     (body y=-0.10, 갑판 z=-0.188), 장축 = body Y, 면 법선 = body X.
			     수면 위 스팬 0.168~0.268 m(갑판에서 10 cm 리프트). 5 cm 리프트로는 부족:
			     실측 흘수(body z=+0.120)에서 판 하단(0.118)이 선체 림(0.115)과 z가 겹쳐
			     BEV 셀에서 판+선체가 한 컴포넌트로 묶이고 z-band가 plate 판정(0.10±0.04)을
			     초과해 기각됨(S4 재판정 중 실측). 10 cm 리프트로 림과 5 cm 분리.
			     센서(0.198 m) 기준 -0.030~+0.070 → ouster_cluster z 크롭 [-0.06, +0.10].
			     plate yaw는 mod-180이라 로봇 헤딩은 브리지에서 베어링 사전정보로 접어
			     해소(구 마스트 2기둥은 제거). -->
			<!-- 반사판 물리 파트(2026-08-11). GTBOT.obj의 판은 **visual 전용**이라 라이다
			     레이캐스트(Bullet 충돌 월드 = physical 메시)가 볼 수 없었고, 그래서 강도
			     모델이 판 대신 돔 상면을 잡아 클러스터가 원형(종횡비 1.1~1.9)이 됐다.
			     GTBOT.obj를 physical로 쓰는 대안은 기각 — 경계 에지 78,221개의 열린 메시라
			     부력(폐부피) 계산이 불안정하고 면 수가 4배(80k)다.
			     시각 판과 동일한 위치·자세·크기의 박스를 충돌체로만 추가한다. 값은 원본
			     메시 실측: 중심 (0.0014, -0.1386, -0.2847), 장축 14 cm·두께 1 cm·높이 10 cm,
			     몸체 x축 기준 -22.4°(-0.391 rad) 회전. 장착 각도는 모델 그대로 유지(사용자
			     지시). 치수를 1~2 mm 작게 잡아 시각 메시와의 동일면 z-fighting을 피한다. -->
			<external_part name="Plate" type="box" physics="floating" buoyant="false">
				<dimensions xyz="0.138 0.008 0.098"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
				<mass value="0.15"/>
				<!-- yaw -1.5708(-90°) = 판 장축이 몸체 y축, 법선이 전방(x)을 향함.
				     GTBOT.obj(2026-08-11 사용자 수정본)의 판과 정확히 일치한다 — 원본
				     메시 실측: 장축 14.0 cm, 두께 1.00 cm, 장축 방위 -90.0°, 중심
				     (0.0014, -0.1386, -0.3347). 즉 시각 메시와 이 충돌 박스가 겹친다.
				     이 정렬이 중요한 이유: 지각은 판 장축이 헤딩에 수직이라고 보고
				     `헤딩 = 적합선 + 90°`로 계산하므로, 판이 틀어져 있으면 그 각도가
				     그대로 헤딩 편향이 된다(수정 전 22° 틀어짐 -> 68° 편향, 전 게이트
				     붕괴: S4 66.7~68.5°, S6 13.0 m). -->
				<compound_transform rpy="0.0 0.0 -1.5708" xyz="0.0014 -0.1386 -0.2847"/>
			</external_part>
		</base_link>
		<!-- 자세 디버깅용 임시 odometry (추후 팔로워 제어에도 유용) -->
		<sensor name="odometry" type="odometry" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/gtbot2/odometry"/>
		</sensor>
		<sensor name="imu" type="imu" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000021 0.000021 0.000023" angular_velocity="0.00050 0.00056 0.00054" linear_acceleration="0.0013 0.0013 0.0023"/>
			<ros_publisher topic="/gtbot2/imu_true"/>
		</sensor>

		<!-- 스러스터 4기: viz 메시의 프로펠러 지오메트리에서 추출한 실제 위치(림 90° 간격,
		     허브 z=0 = 흘수선 15 cm 아래)에 접선 방향으로 장착. body = NED(X·Y 수평, Z 아래).
		     추력은 스러스터 로컬 +X (Thruster.cpp thrustV(thrust,0,0)).
		     setpoint 순서 = 정의 순서 [E, W, N, S]. 믹서:
		       +X 병진: [0,0,-a,+a] / +Y 병진: [-a,+a,0,0] / yaw: [a,a,a,a]
		     주의: right="false" 프로펠러는 +setpoint 추력이 로컬 -X — inverted="true"로
		     상쇄해 부호를 맞춘 상태(W·S). 역추력은 정추력보다 약해(실물과 동일한 비대칭)
		     병진 시 약간의 yaw 커플링이 남음 — 제어기가 닫을 몫. -->
		<actuator name="ThrusterE" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.173 -0.162 0.0" rpy="0.0 0.0 -1.5708"/> <!-- +X_local -> body -Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterW" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.171 -0.162 0.0" rpy="0.0 0.0 1.5708"/> <!-- +X_local -> body +Y -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterN" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 -0.311 0.0" rpy="0.0 0.0 3.1416"/> <!-- +X_local -> body -X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/gtbot/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>
		<actuator name="ThrusterS" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.025 0.033 0.0" rpy="0.0 0.0 0.0"/> <!-- +X_local -> body +X -->
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="true"/>
			<propeller diameter="0.076" right="false">
				<mesh filename="data/robots/gtbot/meshes/cw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="yellow"/>
			</propeller>
		</actuator>

		<ros_subscriber thrusters="/gtbot2/sim_thrusters"/>  <!-- 실기 동일 경로: velocity_loop→bridge→thruster_rpm→rpm_to_sim→여기 -->
		<world_transform rpy="0.0 0.0 0.0" xyz="-0.75 1.3 0.0"/>
	</robot>

