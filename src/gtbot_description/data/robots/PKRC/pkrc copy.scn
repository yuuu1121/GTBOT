<?xml version="1.0"?>
<scenario>
	<looks>
		<look name="pkrc" gray="0.8" roughness="0.4" metalness="0.3"/>
		<look name="blue" rgb="0.0 0.5 1.0" roughness="0.3"/>
		<look name="foam_green" rgb="0.0 1.0 0.0" roughness="0.5"/>
		<look name="ballast_red" rgb="1.0 0.0 0.0" roughness="0.5"/>
	</looks>

	<robot name="$(arg vehicle_name)" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="submerged">
			<external_part name="Hull" type="model" physics="submerged" buoyant="true">
				<physical>
					<mesh filename="data/robots/PKRC/meshes/PKRC_robot.obj" scale="0.01"/>
					<origin rpy="-1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
					<thickness value="0.005"/>
				</physical>
				<visual>
					<mesh filename="data/robots/PKRC/meshes/PKRC_robot.obj" scale="0.01"/>
					<origin rpy="-1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="pkrc"/>
				<compound_transform rpy="0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>

			<internal_part name="FoamTop" type="box" physics="submerged" buoyant="true">
				<dimensions xyz="0.4 0.25 0.25"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="foam_green"/>
				<mass value="0.5"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.4"/>
			</internal_part>

			<internal_part name="BallastBottom" type="sphere" physics="submerged" buoyant="false">
				<dimensions radius="0.15"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Steel"/>
				<look name="ballast_red"/>
				<mass value="5.0"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.4"/>
			</internal_part>
		</base_link>

		<!-- Thrusters -->
        <actuator name="Sway_left" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 -0.15 -0.09" rpy="1.5707963268 3.14 0.0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Sway_right" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 0.15 -0.09" rpy="1.5707963268 3.14 0.0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

		<actuator name="Surge_left" type="thruster">
			<link name="base_link"/>
			<origin xyz="-0.15 0.0 -0.09" rpy="3.14 3.14 1.5707963268"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Surge_right" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.15 0.0 -0.09" rpy="3.14 3.14 1.5707963268"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Heave_left" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 0.16 0.12" rpy="0 1.5707963268 0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

        <actuator name="Heave_right" type="thruster">
			<link name="base_link"/>
			<origin xyz="0.0 -0.16 0.12" rpy="0 1.5707963268 0"/>
			<specs thrust_coeff="0.5" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
			<propeller diameter="0.076" right="true">
				<mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="blue"/>
			</propeller>
		</actuator>

		<!-- Sensors -->
		<sensor name="odometry" type="odometry" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/$(arg vehicle_name)/odometry"/>
		</sensor>

		<sensor name="imu" type="imu" rate="100.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise angle="0.000001745" angular_velocity="0.00001745"/>
			<ros_publisher topic="/$(arg vehicle_name)/imu"/>
		</sensor>

		<sensor name="pressure" type="pressure" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<noise pressure="5.0"/>
			<ros_publisher topic="/$(arg vehicle_name)/pressure"/>
		</sensor>

		<sensor name="dvl" type="dvl" rate="10.0">
			<link name="base_link"/>
			<origin rpy="3.14 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<specs beam_angle="30.0"/>
			<range velocity="9.0 9.0 9.0" altitude_min="0.2" altitude_max="100.0"/>
			<noise velocity="0.0015" altitude="0.001"/>
			<ros_publisher topic="/$(arg vehicle_name)/dvl" altitude_topic="/$(arg vehicle_name)/altitude"/>
		</sensor>

		<sensor name="camera_front1" type="camera" rate="30.0">
			<link name="base_link"/>
			<origin rpy="1.571 0.0 -1.571" xyz="-0.1 -0.051 0.33"/>
			<specs resolution_x="1280" resolution_y="720" horizontal_fov="80.0"/>
			<ros_publisher topic="/$(arg vehicle_name)/camera_front1"/>
		</sensor>

		<sensor name="camera_front2" type="camera" rate="30.0">
			<link name="base_link"/>
			<origin rpy="1.571 0.0 -1.571" xyz="-0.1 0.051 0.33"/>
			<specs resolution_x="1280" resolution_y="720" horizontal_fov="80.0"/>
			<ros_publisher topic="/$(arg vehicle_name)/camera_front2"/>
		</sensor>

		<sensor name="camera_up" rate="60.0" type="camera">
			<specs resolution_x="1600" resolution_y="1200" horizontal_fov="82.0" />
			<origin xyz="0.0 0.0 -0.45" rpy="3.14 0.0 1.571"/>
			<link name="base_link"/>
			<ros_publisher topic="/$(arg vehicle_name)/up"/>
		</sensor>

		<world_transform xyz="$(arg xyz)" rpy="$(arg rpy)"/>
		<ros_base_link_transforms publish="true"/>
		<ros_subscriber thrusters="/$(arg vehicle_name)/setpoint/pwm"/>
	</robot>
</scenario>
