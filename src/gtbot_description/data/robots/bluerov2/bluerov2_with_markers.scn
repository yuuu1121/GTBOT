<?xml version="1.0"?>
<!--
    BlueROV2 with 1 Active Marker facing UP (towards surface)

    Data transmission to BlueBoat:
    - Single marker on top of robot, facing UP
    - 3-frame cycle: X -> Y -> Z -> X -> ...
    - X: ID 110-139, Y: ID 140-169, Z: ID 170-199

    rpy="-1.571 0.0 0.0" = facing UP (opposite of BlueBoat's 1.571 facing DOWN)
-->
<scenario>
    <looks>
        <look name="br2" gray="1.0" roughness="0.4" metalness="0.5" texture="data/robots/bluerov2/meshes/br2.png"/>
        <look name="blue" rgb="0.0 0.5 1.0" roughness="0.3"/>
        <look name="marker_frame" rgb="0.02 0.02 0.02" roughness="0.9" metalness="0.0"/>
        <look name="screen_transparent" rgb="1.0 1.0 1.0" roughness="0.1" metalness="0.0" alpha="0.2"/>
        <look name="marker_led_green" rgb="0.34 0.84 0.41" roughness="0.1" metalness="0.0" emission="10.0"/>
    </looks>

    <robot name="$(arg vehicle_name)" fixed="false" self_collisions="false">
        <base_link name="base_link" type="compound" physics="submerged">
            <external_part name="HullBottom" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="data/robots/bluerov2/meshes/bluerov2_phy.obj" scale="1"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                    <thickness value="0.005"/>
                </physical>
                <visual>
                    <mesh filename="data/robots/bluerov2/meshes/bluerov2.obj" scale="1"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Fiberglass"/>
                <look name="br2"/>
                <compound_transform rpy="0 0.0 0.0" xyz="-0.0 0.0 0.0"/>
            </external_part>

            <external_part name="HeavyFit" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="data/robots/bluerov2/meshes/bluerov2_ring.obj" scale="1"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.03"/>
                    <thickness value="0.005"/>
                </physical>
                <visual>
                    <mesh filename="data/robots/bluerov2/meshes/bluerov2_wings.obj" scale="1"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Fiberglass"/>
                <look name="black"/>
                <compound_transform rpy="0 0.0 0.0" xyz="-0.0 0.0 0.0"/>
            </external_part>

            <!-- Buoyancy/Ballast -->
            <internal_part name="FoamTop" type="box" physics="submerged" buoyant="true">
                <dimensions xyz="0.29 0.25 0.28"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <material name="Neutral"/>
                <look name="None"/>
                <mass value="0.5"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.10"/>
            </internal_part>

            <internal_part name="BallastBottom" type="sphere" physics="submerged" buoyant="false">
                <dimensions radius="0.08"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <material name="Steel"/>
                <look name="black"/>
                <mass value="12.6"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.18"/>
            </internal_part>

            <!-- ============================================== -->
            <!-- Single Active Marker (facing UP towards surface) -->
            <!-- Position: Center-top of robot                    -->
            <!-- ============================================== -->

            <external_part name="MarkerFrame" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="/root/home/vlm_ws/src/stonefish_sim/stonefish_marker/meshes/ActiveMarker.obj" scale="0.01"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="/root/home/vlm_ws/src/stonefish_sim/stonefish_marker/meshes/ActiveMarker.obj" scale="0.01"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="marker_frame"/>
                <mass value="0.05"/>
                <compound_transform rpy="-1.571 0.0 0.0" xyz="0.0 0.0 -0.2"/>
            </external_part>

            <external_part name="MarkerScreen" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="/root/home/vlm_ws/src/stonefish_sim/stonefish_marker/meshes/ActiveMarker_screen.obj" scale="0.01"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="/root/home/vlm_ws/src/stonefish_sim/stonefish_marker/meshes/ActiveMarker_screen.obj" scale="0.01"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="screen_transparent"/>
                <mass value="0.01"/>
                <compound_transform rpy="-1.571 0.0 0.0" xyz="0.0 0.0 -0.2"/>
            </external_part>
        </base_link>

        <!-- Thrusters -->
        <actuator name="FrontRight" type="thruster">
            <link name="base_link"/>
            <origin xyz="0.1355 0.1 0.0725" rpy="0 0 -0.7853981634"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="true">
                <mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="FrontLeft" type="thruster">
            <link name="base_link"/>
            <origin xyz="0.1355 -0.1 0.0725" rpy="0 0 0.7853981634"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="true">
                <mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="BackRight" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.1475 0.1 0.0725" rpy="0 0 -2.3561944902"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="false">
                <mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="BackLeft" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.1475 -0.1 0.0725" rpy="0 0 2.3561944902"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="false">
                <mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="DiveFrontRight" type="thruster">
            <link name="base_link"/>
            <origin xyz="0.12 0.218 0.0" rpy="0 1.5707963268 0"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="true">
                <mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="DiveFrontLeft" type="thruster">
            <link name="base_link"/>
            <origin xyz="0.12 -0.218 0.0" rpy="0 1.5707963268 0"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="false">
                <mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="DiveBackRight" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.12 0.218 0.0" rpy="0 1.5707963268 0"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="false">
                <mesh filename="data/robots/bluerov2/meshes/cw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <actuator name="DiveBackLeft" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.12 -0.218 0.0" rpy="0 1.5707963268 0"/>
            <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3600.0" inverted="false"/>
            <propeller diameter="0.076" right="true">
                <mesh filename="data/robots/bluerov2/meshes/ccw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="blue"/>
            </propeller>
        </actuator>

        <!-- Sensors -->
        <sensor name="odometry" type="odometry" rate="100.0">
            <link name="base_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <ros_publisher topic="/$(arg vehicle_name)/odometry"/>
        </sensor>

        <sensor name="pressure" type="pressure" rate="5.0">
            <link name="base_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <noise pressure="5.0"/>
            <ros_publisher topic="/$(arg vehicle_name)/pressure"/>
        </sensor>

        <sensor name="imu_filter" type="imu" rate="20.0">
            <link name="base_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <noise angle="0.000001745" angular_velocity="0.00001745"/>
            <ros_publisher topic="/$(arg vehicle_name)/imu"/>
        </sensor>

        <sensor name="dvl" type="dvl" rate="5.0">
            <link name="base_link"/>
            <origin rpy="3.14 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <specs beam_angle="30.0"/>
            <range velocity="9.0 9.0 9.0" altitude_min="0.2" altitude_max="100.0"/>
            <noise velocity="0.0015" altitude="0.001"/>
            <ros_publisher topic="/$(arg vehicle_name)/dvl_sim"
                           altitude_topic="/$(arg vehicle_name)/altitude"/>
        </sensor>

        <!-- Camera looking UP (for BlueBoat's localization markers) -->
        <sensor name="camera_up" rate="30.0" type="camera">
            <specs resolution_x="1280" resolution_y="960" horizontal_fov="82.0" />
            <origin xyz="0.2 0.0 -0.15" rpy="3.14 0.0 0.0"/>
            <link name="base_link"/>
            <ros_publisher topic="/$(arg vehicle_name)/up"/>
        </sensor>

        <!-- ============================================== -->
        <!-- Single Active Marker LED (facing UP)          -->
        <!-- 3-frame cycle: X -> Y -> Z                    -->
        <!-- ============================================== -->

        <light name="aruco_led_data">
            <specs illuminance="5000.0" radius="0.06" cone_angle="10" blink="0.1" shape="aruco" aruco_id="155"/>
            <color rgb="1.0 1.0 1.0"/>
            <link name="base_link"/>
            <origin xyz="0.0 0.0 0.438" rpy="3.14 0.0 0.0"/>
            <ros_subscriber aruco_id="/$(arg vehicle_name)/data_marker/aruco_id"/>
        </light>
        <light name="LED_OUTER_DATA">
            <specs radius="0.105" cone_angle="10.0" blink="0.1" illuminance="5000.0" shape="circle_square_hole" inner_radius="0.07"/>
            <color rgb="0.34 0.84 0.415"/>
            <link name="base_link"/>
            <origin xyz="0.0 0.0 0.95" rpy="3.14 0.0 0.0"/>
        </light>

        <world_transform xyz="$(arg xyz)" rpy="$(arg rpy)"/>
        <ros_base_link_transforms publish="true"/>
        <ros_subscriber thrusters="/$(arg vehicle_name)/setpoint/pwm"/>
    </robot>
</scenario>
