<?xml version="1.0"?>
<scenario>
	<looks>
		<look name="black" gray="0.05" roughness="0.2"/>
		<!-- 액티브마커 스크린용(2026-08-18). 참조 blueboat_with_camera.scn과 같은 값 —
		     Stonefish look에는 알파가 없어 실제로 투과되지는 않고, 프레임(black)과
		     구분되는 매끈한 흰 면으로 보인다. 이름은 참조 구성과 맞춰 둔다. -->
		<look name="transparent" gray="1.0" roughness="0.0" metalness="0.0"/>
		<look name="white" gray="1.0" roughness="0.2"/>
		<look name="yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>
		<look name="gray" gray="0.5" roughness="0.4" metalness="0.5"/>
		<look name="orange" rgb="0.9 0.1 0.0" roughness="0.3"/>
		<look name="seabed" rgb="0.40 0.35 0.25" roughness="0.85"/>
	</looks>
</scenario>
