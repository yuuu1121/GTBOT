<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS 공유메모리 전송 프로파일 (2026-08-17)

  왜 필요한가: /ouster/points 한 스캔이 점 32,800개 x 16 B = **512 KiB**다. 계측 결과
  시뮬은 정확히 10.01 Hz로 발행하고 발행 자체는 0.4 ms인데, 구독자는 3~5 Hz만 받고
  ouster_cluster(C++)는 0.77 Hz만 받았다 — 즉 유실은 시뮬이 아니라 전송 계층에서 난다.

  Fast DDS 기본 SHM 세그먼트가 512 KiB로 메시지 크기와 같아 이 메시지는 SHM에 안 들어가고
  UDP로 폴백한다. 512 KiB를 1.5 KB MTU로 쪼개면 ~350 조각이고 하나만 잃어도 샘플 전체가
  버려진다. 컨테이너에 /proc/sys/net이 없어 커널 소켓 버퍼(rmem_max)는 못 올린다.

  그래서 세그먼트를 64 MiB로 키우고 SHM만 쓰게 한다. 이 시스템은 발행자·구독자가 모두
  같은 호스트라 UDP가 필요 없다 — **다른 기계와 통신해야 하면 이 프로파일을 쓰지 말 것**
  (useBuiltinTransports=false가 UDP를 끈다).

  사용:
    export FASTRTPS_DEFAULT_PROFILES_FILE=$(ros2 pkg prefix gtbot_description)/share/gtbot_description/config/fastdds_shm.xml
  ros2 daemon과 모든 노드가 같은 값을 봐야 한다 — daemon을 먼저 재시작할 것.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_big</transport_id>
        <type>SHM</type>
        <!-- **세그먼트는 참가자마다 하나씩 잡힌다** — 편대 스택은 노드가 15개쯤이라
             총합이 /dev/shm 용량(64 MiB)을 넘으면 안 된다. 8 MiB로 잡았을 때
             참가자 2~3개인 단독 시뮬은 되지만 전체 스택은 "Failed to create segment
             ... No such file or directory"로 노드가 통째로 죽었다(실측 2026-08-17).
             2 MiB x 15 = 30 MiB면 여유가 있고, 512 KiB 메시지 4개가 들어가 BEST_EFFORT
             구독에는 충분하다. 노드를 크게 늘리거나 /dev/shm이 작은 기계에서는
             이 값을 더 줄일 것 — 보정 노브다. -->
        <segment_size>2097152</segment_size>
        <!-- segment_size 이하여야 한다(초과 시 "max_message_size cannot be greater
             than segment_size"로 SHM 등록 실패 -> 노드 사망, 실측). 512 KiB
             메시지에 2배 여유. -->
        <maxMessageSize>1048576</maxMessageSize>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="shm_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_big</transport_id>
        </userTransports>
        <!-- false = UDP/TCP 내장 전송을 끈다(같은 호스트 전용) -->
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
